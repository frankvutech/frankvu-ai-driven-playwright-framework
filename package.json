{
  "name": "ai-driven-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI/API test framework (Page Object Model)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=\"ui-*\"",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:framework": "playwright test --project=framework-unit",
    "example-app": "tsx example-app/main.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:allure:serve": "allure serve allure-results",
    "lint": "eslint . --max-warnings 0",
    "test:agent": "playwright test --project=agent-unit",
    "test:agent-integration": "playwright test --project=agent-integration",
    "agent": "tsx src/agent/cli.ts",
    "eval": "tsx eval/run.ts --mode deterministic --baseline eval/baselines/deterministic.json",
    "eval:live": "tsx eval/run.ts --mode live",
    "test:eval": "playwright test --project=eval-unit",
    "eval:functional": "tsx eval/run.ts --mode functional --baseline eval/baselines/functional.json",
    "eval:healing": "tsx eval/run.ts --mode healing --baseline eval/baselines/healing.json",
    "eval:compare": "tsx eval/run.ts --compare",
    "eval:probe-defects": "tsx eval/probes/seeded-defects.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankvutech/frankvu-ai-driven-playwright-framework.git"
  },
  "author": "Frank Vu",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/frankvutech/frankvu-ai-driven-playwright-framework/issues"
  },
  "homepage": "https://github.com/frankvutech/frankvu-ai-driven-playwright-framework#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-playwright": "^3.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  }
}
