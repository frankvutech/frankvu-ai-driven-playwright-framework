  },
  "homepage": "https://github.com/frankvutech/frankvu-ai-driven-playwright-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
