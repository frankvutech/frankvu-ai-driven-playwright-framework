# Copy to .env (git-ignored) and change only what you need.
# Real environment variables take precedence over this file.
# Only the keys below are read; anything else in .env is ignored by the framework.

# Sauce Demo storefront used by the UI suite.
UI_BASE_URL=https://www.saucedemo.com

# JSONPlaceholder REST API used by tests/api/posts.spec.ts.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Leave unset to let the tests start the local example app (example-app/) on a
# random port in each worker. Set it only to point at a deployed copy.
# EXAMPLE_APP_URL=http://localhost:4010

# Comma-separated UI browser projects: chromium, firefox, webkit.
# Install the browsers first: npx playwright install firefox webkit
UI_BROWSERS=chromium

# Public demo password published on saucedemo.com's login page.
# SAUCE_PASSWORD=secret_sauce

# Password for the example app's test users (min. 8 characters). The local app
# is started with this value, so any value works locally.
# EXAMPLE_APP_PASSWORD=example-app-pass
