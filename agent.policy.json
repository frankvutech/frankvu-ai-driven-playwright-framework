  },
  "healing": {
    "reproduceRuns": 3,
    "verifyRuns": 3,
    "maxWaitTimeoutMs": 15000,
    "maxChanges": 2,
    "patchableRoots": [
      "src/pages/",
      "src/components/"
    ]
  }
